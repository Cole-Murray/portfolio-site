# Copy to `.env.local` and fill in as needed. No secrets belong in git.

# Canonical site origin used for metadata, OG tags, robots, and sitemap.
# Falls back to the value in src/content/site.ts when unset.
NEXT_PUBLIC_SITE_URL=

# Fine-grained PAT for the live GitHub contributions card (server-only).
# Never prefix with NEXT_PUBLIC_. Copy this file to `.env.local` for local use,
# and set the same key in Vercel → Environment Variables for deploy.
GITHUB_TOKEN=
